{"question": "What percentage of each shipper's delivered loads were profitable after accounting for transportation costs and operating overhead?", "generated_sql": "SELECT\n    s.shipper_name,\n    COUNT(*) FILTER (WHERE f.is_delivered) AS delivered_loads,\n    COUNT(*) FILTER (WHERE f.is_delivered AND f.pnl > 0) AS profitable_delivered_loads,\n    ROUND(\n        100.0 * COUNT(*) FILTER (WHERE f.is_delivered AND f.pnl > 0)\n        / NULLIF(COUNT(*) FILTER (WHERE f.is_delivered), 0),\n        2\n    ) AS pct_profitable_delivered_loads\nFROM main_analytics.fct_loads f\nJOIN main_analytics.dim_shipper s\n    ON f.shipper_key = s.shipper_key\nGROUP BY s.shipper_name\nHAVING COUNT(*) FILTER (WHERE f.is_delivered) > 0\nORDER BY pct_profitable_delivered_loads DESC", "answer": [{"shipper_name": "Shipper 882", "delivered_loads": 2, "profitable_delivered_loads": 2, "pct_profitable_delivered_loads": 100.0}, {"shipper_name": "Shipper 1303", "delivered_loads": 1, "profitable_delivered_loads": 1, "pct_profitable_delivered_loads": 100.0}, {"shipper_name": "Shipper 801", "delivered_loads": 3, "profitable_delivered_loads": 3, "pct_profitable_delivered_loads": 100.0}, {"shipper_name": "Shipper 1395", "delivered_loads": 2, "profitable_delivered_loads": 2, "pct_profitable_delivered_loads": 100.0}, {"shipper_name": "Shipper 1103", "delivered_loads": 19, "profitable_delivered_loads": 19, "pct_profitable_delivered_loads": 100.0}, {"shipper_name": "Shipper 1342", "delivered_loads": 1, "profitable_delivered_loads": 1, "pct_profitable_delivered_loads": 100.0}, {"shipper_name": "Shipper 860", "delivered_loads": 2, "profitable_delivered_loads": 2, "pct_profitable_delivered_loads": 100.0}, {"shipper_name": "Shipper 496", "delivered_loads": 1, "profitable_delivered_loads": 1, "pct_profitable_delivered_loads": 100.0}, {"shipper_name": "Shipper 948", "delivered_loads": 1, "profitable_delivered_loads": 1, "pct_profitable_delivered_loads": 100.0}, {"shipper_name": "Shipper 1063", "delivered_loads
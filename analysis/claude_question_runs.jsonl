{"question": "What are the top 5 lanes by number of delivered loads?", "generated_sql": "SELECT\n    l.lane,\n    COUNT(*) AS delivered_load_count\nFROM main_analytics.fct_loads f\nJOIN main_analytics.dim_lane l\n    ON f.lane_key = l.lane_key\nWHERE f.is_delivered = TRUE\nGROUP BY l.lane\nORDER BY delivered_load_count DESC\nLIMIT 5", "answer": [{"lane": "Hawkins,TX -> Roanoke,TX", "delivered_load_count": 882}, {"lane": "Lodi,CA -> Pacific,WA", "delivered_load_count": 150}, {"lane": "Kent,WA -> Spokane,WA", "delivered_load_count": 94}, {"lane": "Henderson,NV -> Tracy,CA", "delivered_load_count": 87}, {"lane": "Taft,CA -> Tracy,CA", "delivered_load_count": 72}], "id": "q4", "assumption": "Count delivered loads only and group by modeled lane."}
{"question": "Which carrier moved the most loads into Texas?", "generated_sql": "SELECT\n    c.carrier_name,\n    COUNT(*) AS load_count\nFROM main_analytics.fct_loads f\nJOIN main_analytics.dim_lane l\n    ON f.lane_key = l.lane_key\nJOIN main_analytics.dim_carrier c\n    ON f.carrier_key = c.carrier_key\nWHERE l.delivery_state = 'TX'\n    AND f.is_delivered = true\nGROUP BY c.carrier_name\nORDER BY load_count DESC\nLIMIT 1", "answer": [{"carrier_name": "Carrier 567581", "load_count": 188}], "id": "q5", "assumption": "Interpret moved as delivered and count delivered loads with delivery_state = TX."}
{"question": "How does the average book price compare between intrastate and interstate loads?", "generated_sql": "SELECT\n    haul_type,\n    AVG(book_price) AS avg_book_price,\n    COUNT(*) AS load_count\nFROM main_analytics.fct_loads\nGROUP BY haul_type\nORDER BY haul_type", "answer": [{"haul_type": "interstate", "avg_book_price": 1709.3332079207876, "load_count": 3535}, {"haul_type": "intrastate", "avg_book_price": 584.1651317233789, "load_count": 1822}], "id": "q6", "assumption": "Use all modeled loads and the documented haul_type definition."}
{"question": "For the shipper with the most delivered loads, how did monthly volume change across the period covered by the data?", "generated_sql": "WITH top_shipper AS (\n  SELECT shipper_key\n  FROM main_analytics.fct_loads\n  WHERE is_delivered\n  GROUP BY shipper_key\n  ORDER BY COUNT(*) DESC\n  LIMIT 1\n)\nSELECT\n  d.year_month,\n  COUNT(f.loadsmart_id) AS delivered_load_count\nFROM main_analytics.dim_date d\nLEFT JOIN main_analytics.fct_loads f\n  ON f.delivery_date = d.date_day\n  AND f.is_delivered\n  AND f.shipper_key = (SELECT shipper_key FROM top_shipper)\nGROUP BY d.year_month\nORDER BY d.year_month", "answer": [{"year_month": "2024-01", "delivered_load_count": 127}, {"year_month": "2024-02", "delivered_load_count": 108}, {"year_month": "2024-03", "delivered_load_count": 178}, {"year_month": "2024-04", "delivered_load_count": 191}, {"year_month": "2024-05", "delivered_load_count": 163}, {"year_month": "2024-06", "delivered_load_count": 165}, {"year_month": "2024-07", "delivered_load_count": 137}, {"year_month": "2024-08", "delivered_load_count": 126}, {"year_month": "2024-09", "delivered_load_count": 137}, {"year_month": "2024-10", "delivered_load_count": 153}, {"year_month": "2024-11", "delivered_load_count": 192}, {"year_month": "2024-12", "delivered_load_count": 116}, {"year_month": "2025-01", "delivered_load_count": 40}, {"year_month": "2025-02", "delivered_load_count": 0}, {"year_month": "2025-03", "delivered_load_count": 1}], "id": "q7", "assumption": "Identify the shipper by total delivered load count, then count that shipper's delivered loads by delivery month."}
{"question": "Among lanes with at least 10 delivered loads, which had the highest average book price?", "generated_sql": "SELECT\n    l.lane,\n    COUNT(*) AS delivered_load_count,\n    AVG(f.book_price) AS avg_book_price\nFROM main_analytics.fct_loads f\nJOIN main_analytics.dim_lane l\n    ON f.lane_key = l.lane_key\nWHERE f.is_delivered = TRUE\nGROUP BY l.lane\nHAVING COUNT(*) >= 10\nORDER BY avg_book_price DESC\nLIMIT 1", "answer": [{"lane": "Stockton,CA -> Parrish,FL", "delivered_load_count": 11, "avg_book_price": 6800.0}], "id": "q8", "assumption": "Filter lanes to at least 10 delivered loads, then rank by mean book_price across those delivered loads."}
{"question": "what are the top 10 lanes in terms of pnl ratio?", "generated_sql": "SELECT\n    dl.lane,\n    SUM(fl.pnl) AS total_pnl,\n    SUM(fl.book_price) AS total_book_price,\n    SUM(fl.pnl) / NULLIF(SUM(fl.book_price), 0) AS pnl_ratio\nFROM main_analytics.fct_loads fl\nJOIN main_analytics.dim_lane dl\n    ON fl.lane_key = dl.lane_key\nWHERE fl.book_price > 0\nGROUP BY dl.lane\nORDER BY pnl_ratio DESC\nLIMIT 10", "answer": [{"lane": "Upper Marlboro,MD -> Methuen,MA", "total_pnl": 1287.87, "total_book_price": 1387.87, "pnl_ratio": 0.9279471420233883}, {"lane": "Fort Collins,CO -> Upper Marlboro,MD", "total_pnl": 2128.72, "total_book_price": 2613.72, "pnl_ratio": 0.8144407205056394}, {"lane": "Springdale,AR -> Roanoke,TX", "total_pnl": 1463.07, "total_book_price": 2283.07, "pnl_ratio": 0.6408344904010826}, {"lane": "Trenton,MO -> Laredo,TX", "total_pnl": 2482.17, "total_book_price": 4082.17, "pnl_ratio": 0.6080516000068591}, {"lane": "Newark,NJ -> Harrisburg,PA", "total_pnl": 1428.44, "total_book_price": 2428.44, "pnl_ratio": 0.5882130091746142}, {"lane": "Granite City,IL -> Anderson,IN", "total_pnl": 1810.8, "total_book_price": 3160.8, "pnl_ratio": 0.5728929384965831}, {"lane": "Brook Park,OH -> Reading,PA", "total_pnl": 300.0, "total_book_price": 600.0, "pnl_ratio": 0.5}, {"lane": "Kendallville,IN -> Mount Holly,NC", "total_pnl": 1563.53, "total_book_price": 3213.53, "pnl_ratio": 0.4865459479139762}, {"lane": "Aurora,CO -> Rock Springs,WY", "total_pnl": 1289.38, "total_book_price": 2789.38, "pnl_ratio": 0.46224609052907817}, {"lane": "Baldwinsville,NY -> Columbus,OH", "total_pnl": 978.28, "total_book_price": 2148.28, "pnl_ratio": 0.4553782560932466}], "id": "q9", "why_it_matters": "Understand what lanes are more profitable in relative terms, not only gross, and might uncover better business opportunities."}
